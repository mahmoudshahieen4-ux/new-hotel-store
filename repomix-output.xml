<file path="app/api/confirm/route.ts">
import { redirect } from "next/navigation";
import { type NextRequest } from "next/server";
import db from "@/utils/db";

/**
 * Kashier hosted-checkout return callback.
 *
 * Kashier redirects the buyer back to `merchantRedirect` (this route) with
 * query parameters such as `orderId`, `transactionId` and `paymentStatus`
 * (values like `TRX_SUCCESS` / `TRX_FAILED`).
 */
export const GET = async (req: NextRequest) => {
  const { searchParams } = new URL(req.url);
  const orderId = searchParams.get("orderId");
  const paymentStatus =
    searchParams.get("paymentStatus") ||
    searchParams.get("trxStatus") ||
    searchParams.get("success");

  try {
    if (orderId) {
      const order = await db.order.findUnique({
        where: { paymentOrderId: orderId },
      });
      if (order) {
        const isPaid =
          paymentStatus === "TRX_SUCCESS" ||
          paymentStatus === "true" ||
          paymentStatus === "1" ||
          paymentStatus === "paid";

        if (isPaid) {
          await db.order.update({
            where: { id: order.id },
            data: { isPaid: true },
          });
          // Clear the user's cart after a successful payment.
          await db.cart.deleteMany({
            where: { userId: order.userId },
          });
        }
      }
    }
  } catch (error) {
    console.log(error);
  }
  redirect("/orders");
};
</file>

<file path="app/api/payment/route.ts">
import { type NextRequest } from "next/server";
import db from "@/utils/db";
import {
  buildKashierCheckoutUrl,
  generateKashierOrderId,
  isKashierConfigured,
} from "@/utils/kashier";

export const POST = async (req: NextRequest) => {
  const requestHeaders = new Headers(req.headers);
  const origin = requestHeaders.get("origin");

  const { orderId, cartId } = await req.json();

  const order = await db.order.findUnique({
    where: { id: orderId },
  });
  const cart = await db.cart.findUnique({
    where: { id: cartId },
  });
  if (!order || !cart) {
    return Response.json(null, {
      status: 404,
      statusText: "Not Found",
    });
  }

  if (!isKashierConfigured()) {
    return Response.json({
      url: null,
      message:
        "Kashier is not configured. Set KASHIER_MERCHANT_ID and KASHIER_HASH_KEY in your .env file.",
    });
  }

  // Kashier requires a unique order reference of max 35 chars.
  // Persist it once so the return callback can map back to our order.
  const paymentOrderId = order.paymentOrderId ?? generateKashierOrderId();
  if (!order.paymentOrderId) {
    await db.order.update({
      where: { id: order.id },
      data: { paymentOrderId },
    });
  }

  const merchantRedirect = `${origin}/api/confirm`;
  const failureRedirect = `${origin}/checkout?orderId=${order.id}&cartId=${cart.id}`;

  const url = buildKashierCheckoutUrl({
    orderId: paymentOrderId,
    amount: order.orderTotal,
    merchantRedirect,
    failureRedirect,
    customerEmail: order.email || undefined,
    customerName: undefined,
  });

  return Response.json({ url });
};
</file>

